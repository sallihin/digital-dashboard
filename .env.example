# Copy this file to .env on the server and fill in the values.
# .env is ignored by git, so the real password never goes into the repo.

# Password for the login screen. Changing it signs everyone out.
DASHBOARD_PASSWORD=change-me

# Port the server listens on.
PORT=3000

# Where data is saved (relative to this folder).
DATA_FILE=data/db.json

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Set to true when the site is served over HTTPS.
SECURE_COOKIE=false

# Set to true when running behind Nginx, Caddy or another reverse proxy.
TRUST_PROXY=false
